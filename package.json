{
  "license": "MIT",
  "name": "@ankhorage/orchestrator-module-expo-google-fonts",
  "version": "0.2.1",
  "description": "Expo Google Fonts module for @ankhorage/orchestrator.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/ankhorage/orchestrator-module-expo-google-fonts#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/orchestrator-module-expo-google-fonts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/orchestrator-module-expo-google-fonts.git"
  },
  "keywords": [
    "typescript",
    "expo",
    "google-fonts",
    "fonts",
    "orchestrator-module",
    "react-native"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.json",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json && bun x tsc --noEmit -p tsconfig.scripts.json",
    "validate:sdk57-consumer": "bun scripts/validateSdk57Consumer.ts",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "ankhorage-prettier --check README.md",
    "changeset": "ankhorage-changeset",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip"
  },
  "dependencies": {
    "@ankhorage/expo-runtime": "^3.0.0",
    "@ankhorage/orchestrator": "^0.3.1"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.8.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.0",
  "publishConfig": {
    "access": "public"
  }
}
